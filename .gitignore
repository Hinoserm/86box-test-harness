local.toml
results/
__pycache__/
# Image disks come from `harness sync` or are put there by hand; only their
# descriptors are part of the repository.
images/*
!images/*.toml
# CMOS files only: a flash dump in nvr/ is the board's BIOS.
machines/**/nvr/*
!machines/**/nvr/*.nvr
machines/**/nvr-*/*
!machines/**/nvr-*/*.nvr
