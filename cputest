#!/usr/bin/env python3
"""The CPU accuracy test bench: boots the test image on every machine on
file that can hold a given CPU, and compares what comes out.

  cputest CPU [--machine M ...] [--speed S | --all-speeds] [--box BUILD]
              [--image IMG] [-j N] [--passes N] [--timeout S] [--interp]
  cputest list [CPU]          machines, and the speeds each takes
  cputest sync                copy the newest test image into images/
  cputest golden CPU LOG      keep a real machine's serial log as reference
  cputest setup BOARD         boot a board for its BIOS setup, driven through
                              results/setup-<board>/ctl; `save` keeps its CMOS

CPU is an alias (p54c, p55c, k6-2, k6-3, k6-3+, ppro, ...) or any 86Box
CPU family's internal name. Machines are machines/<socket>/<board>/, each
an 86box.cfg plus a saved nvr/. A run never boots the template itself: it
works on a copy in results/, with the CPU lines set.
"""

import argparse
import concurrent.futures
import configparser
import datetime
import hashlib
import io
import os
import re
import shutil
import subprocess
import sys
import threading
import time
import tomllib

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import launch  # noqa: E402
import tables  # noqa: E402

MACHINES = os.path.join(HERE, "machines")
IMAGES = os.path.join(HERE, "images")
GOLDEN = os.path.join(HERE, "golden")
RESULTS = os.path.join(HERE, "results")

ALIASES = {
    "p54c": "pentium_p54c", "pentium": "pentium_p54c",
    "p55c": "pentium_p55c", "mmx": "pentium_p55c", "pmmx": "pentium_p55c",
    "k6": "k6_m7", "k6-m6": "k6_m6", "k6-m7": "k6_m7",
    "k6-2": "k6_2", "k6-2+": "k6_2p", "k6-3": "k6_3", "k6-3+": "k6_3p",
    "k6-iii": "k6_3", "k6-iii+": "k6_3p",
    "ppro": "pentiumpro", "pentium-pro": "pentiumpro", "p6": "pentiumpro",
}

# Wall-clock limits. Machines run fast-forwarded, and the test prints
# PROGRESS every 3 guest seconds, so a quiet machine is a broken one.
HEADER_WAIT = 10     # power-on to the CPUTEST line (boards take 2-3 s)
RESULTS_WAIT = 3     # CPUTEST line to the first START/PROGRESS/GROUP line (0.3 s)
STALL = 30           # between any two outputs once running

print_lock = threading.Lock()


def say(*args):
    with print_lock:
        print(*args, flush=True)


# ---- settings ---------------------------------------------------------------

def settings():
    path = os.path.join(HERE, "local.toml")
    if not os.path.exists(path):
        raise SystemExit("no bench/local.toml: copy local.example.toml and fill it in")
    with open(path, "rb") as f:
        s = tomllib.load(f)
    s.setdefault("builds", {})
    return s


def expand(p):
    return os.path.abspath(os.path.expanduser(p))


def resolve_build(s, name):
    """--box NAME from local.toml, or a path to an 86Box binary."""
    name = name or os.environ.get("CPUTEST_BOX") or s.get("default_build")
    if not name:
        raise SystemExit("no build: pass --box, set CPUTEST_BOX, or default_build in local.toml")
    if name in s["builds"]:
        b = s["builds"][name]
        binary, source = expand(b["binary"]), expand(b["source"])
    else:
        binary = expand(name)
        # .../<tree>/<builddir>/src/86Box -> <tree>
        source = os.path.dirname(os.path.dirname(os.path.dirname(binary)))
        name = os.path.basename(source)
    if not os.access(binary, os.X_OK):
        raise SystemExit("%s: not an executable" % binary)
    if not os.path.exists(os.path.join(source, "src", "cpu", "cpu_table.c")):
        raise SystemExit("%s: not an 86Box source tree (needed for its CPU and machine tables)" % source)

    def git(*a):
        r = subprocess.run(["git", "-C", source] + list(a), capture_output=True, text=True)
        return r.stdout.strip()
    rev = git("rev-parse", "--short", "HEAD") or "?"
    dirty = "-dirty" if git("status", "--porcelain", "--untracked-files=no") else ""
    config_c = open(os.path.join(source, "src", "config.c"), encoding="latin-1").read()
    return dict(name=name, binary=binary, source=source,
                label="%s %s@%s%s" % (name, git("branch", "--show-current") or "detached", rev, dirty),
                fast_forward_option='"fast_forward"' in config_c)


def resolve_cpu(families, arg):
    key = arg.lower()
    if key in ALIASES:
        key = ALIASES[key]
    key = key.replace("-", "_")
    if key in families:
        return families[key]
    norm = lambda t: re.sub(r"[^a-z0-9+]", "", t.lower())  # noqa: E731
    for f in families.values():
        if norm(f.name) == norm(arg):
            return f
    raise SystemExit("unknown CPU %r; aliases: %s" % (arg, ", ".join(sorted(ALIASES))))


# ---- machines ---------------------------------------------------------------

def read_cfg(path):
    cfg = configparser.ConfigParser(interpolation=None, strict=False)
    cfg.optionxform = str
    cfg.read(path)
    return cfg


def cfg_text(cfg):
    out = io.StringIO()
    cfg.write(out)
    return out.getvalue()


def templates(only=None):
    found = []
    for socket in sorted(os.listdir(MACHINES)):
        sdir = os.path.join(MACHINES, socket)
        if not os.path.isdir(sdir):
            continue
        for board in sorted(os.listdir(sdir)):
            d = os.path.join(sdir, board)
            if not os.path.exists(os.path.join(d, "86box.cfg")):
                continue
            slug = "%s/%s" % (socket, board)
            if only and not any(o.lower() in (slug.lower(), board.lower()) for o in only):
                continue
            found.append(dict(slug=slug, board=board, dir=d,
                              machine=read_cfg(os.path.join(d, "86box.cfg"))["Machine"]["machine"]))
    return found


def speeds_for(fam, mach, speed=None, all_speeds=False):
    ok = [c for c in fam.cpus if tables.is_eligible(fam, c, mach)]
    if speed:
        return [c for c in ok if c.name == speed or c.name.split()[0] == speed or c.name.split("/")[0] == speed]
    ok = [c for c in ok if not c.out_of_spec]
    if all_speeds:
        return ok
    return ok[-1:] if ok else []


# ---- output -----------------------------------------------------------------

def parse_log(text):
    """The CPUTEST header, every GROUP line, MISMATCH count and DONE lines."""
    r = dict(version=None, cpu=None, groups={}, skipped={}, mismatch_lines=0, done=[], pass_diff=set())
    for line in text.replace("\r", "").splitlines():
        line = line.strip()
        m = re.match(r"CPUTEST (\S+) .*?cpu=(.*)$", line)
        if m:
            r["version"], r["cpu"] = m.group(1), m.group(2)
        elif line.startswith("GROUP "):
            parts = line.split()
            if len(parts) > 2 and parts[2] == "skipped:":
                r["skipped"][parts[1]] = " ".join(parts[3:])
            elif len(parts) > 2:
                g = dict(p.split("=", 1) for p in parts[2:] if "=" in p)
                prev = r["groups"].get(parts[1])
                # Every pass must print the same CRCs.
                if prev and any(prev.get(k) != g.get(k) for k in ("crc_interp", "crc_comp", "crc_defined")):
                    r["pass_diff"].add(parts[1])
                r["groups"].setdefault(parts[1], g)
        elif line.startswith("MISMATCH"):
            r["mismatch_lines"] += 1
        elif line.startswith("DONE "):
            r["done"].append(line)
    return r


def golden_path(fam, version):
    return os.path.join(GOLDEN, fam.internal_name, "v%s.log" % version)


def load_golden(fam, version):
    p = golden_path(fam, version)
    if not os.path.exists(p):
        return None
    return parse_log(open(p, errors="replace").read())


# ---- one run ----------------------------------------------------------------

def prepare_case(s, build, image, t, case, fam=None, cpu=None, interp=False):
    """A run's own copy of machine T in CASE: its CMOS, private copies of the
    emulator and the disk, and the cfg with the CPU (when given) set.
    Returns the cfg text, with @SERIAL@ for the launcher to fill."""
    os.makedirs(case, exist_ok=True)
    nvr = os.path.join(case, "nvr")
    if os.path.exists(nvr):
        shutil.rmtree(nvr)
    os.makedirs(nvr)
    # The CMOS only: flash dumps are rebuilt from the BIOS ROM.
    for f in os.listdir(os.path.join(t["dir"], "nvr")):
        if f.endswith(".nvr"):
            shutil.copy2(os.path.join(t["dir"], "nvr", f), nvr)
    roms = os.path.join(case, "roms")
    if not os.path.islink(roms):
        os.symlink(expand(s.get("roms", "~/.local/share/86Box/roms")), roms)
    # Private copies: a rebuild or a new image mid-run can't change this run.
    shutil.copy2(build["binary"], os.path.join(case, "86Box.bin"))
    disk = os.path.join(case, "cputest.img")
    shutil.copy2(image, disk)

    cfg = read_cfg(os.path.join(t["dir"], "86box.cfg"))
    m = cfg["Machine"]
    if fam:
        m["cpu_family"] = fam.internal_name
        m["cpu_speed"] = str(cpu.rspeed)
        m["cpu_multi"] = ("%g" % cpu.multi) if cpu.multi != int(cpu.multi) else "%d" % cpu.multi
    m["cpu_use_dynarec"] = "0" if interp else "1"
    cfg["Hard disks"]["hdd_01_fn"] = disk
    cfg["General"]["fast_forward"] = "1"
    return cfg_text(cfg)


def drop_copies(case):
    for f in ("86Box.bin", "cputest.img"):
        p = os.path.join(case, f)
        if os.path.exists(p):
            os.unlink(p)


def run_one(s, build, image, fam, cpu, t, rundir, args):
    tag = "%s %s" % (t["slug"], cpu.name)
    case = os.path.join(rundir, "%s-%s" % (t["slug"].replace("/", "-"), re.sub(r"[^0-9A-Za-z]+", "_", cpu.name)))
    cfg = prepare_case(s, build, image, t, case, fam, cpu, args.interp)
    box = launch.Box(case, os.path.join(case, "86Box.bin"))
    status = "never started"
    notes = []
    start = time.time()
    try:
        box.start(cfg)
        header_at = None
        first_output = False
        last_len, last_change = 0, time.time()
        while time.time() - start < args.timeout:
            box.pump(0.25)
            text = box.buf.decode("latin-1")
            if len(text) != last_len:
                last_len, last_change = len(text), time.time()
            if not box.alive():
                status = "emulator exited (%s)" % box.box.returncode
                break
            if header_at is None:
                if "CPUTEST " in text:
                    header_at = time.time()
                    notes.append("CPUTEST at %.1f s" % (header_at - start))
                elif time.time() - start > HEADER_WAIT:
                    status = "no CPUTEST line within %d s: the machine never ran the test (screen.png)" % HEADER_WAIT
                    break
                continue
            if not first_output:
                if re.search(r"^(START|PROGRESS|GROUP) ", text, re.M):
                    first_output = True
                    notes.append("first output at %.1f s" % (time.time() - start))
                elif time.time() - header_at > RESULTS_WAIT:
                    status = "CPUTEST started but no test output within %d s (screen.png)" % RESULTS_WAIT
                    break
                continue
            done = [l for l in text.splitlines() if l.startswith("DONE ")]
            if len(done) >= args.passes:
                status = "done"
                break
            if time.time() - last_change > STALL:
                status = "hung: nothing on COM1 for %d s (screen.png)" % STALL
                break
        else:
            status = "timed out after %d s" % args.timeout
        box.shot("screen.png")
    finally:
        box.stop()
        drop_copies(case)
    result = parse_log(box.buf.decode("latin-1"))
    result.update(tag=tag, slug=t["slug"], speed=cpu.name, status=status, notes=notes,
                  seconds=int(time.time() - start), case=case)
    say("  %-28s %s, %d s" % (tag, status, result["seconds"]))
    return result


# ---- report -----------------------------------------------------------------

def report(fam, build, image_info, results, out):
    lines = []
    w = lines.append
    w("cputest %s (%s)" % (fam.internal_name, fam.name))
    w("build   %s" % build["label"])
    w("image   %s" % image_info)
    w("")
    ok = True
    versions = {r["version"] for r in results if r["version"]}
    golden = {v: load_golden(fam, v) for v in versions}
    for r in results:
        g = golden.get(r["version"])
        w("%s  [%s, %d s%s]" % (r["tag"], r["status"], r["seconds"],
                                (", " + ", ".join(r["notes"])) if r["notes"] else ""))
        if r["cpu"]:
            w("  cpu %s" % r["cpu"])
        if r["status"] != "done":
            ok = False
        for name, gr in r["groups"].items():
            bad = []
            if gr.get("mismatches", "0") != "0":
                bad.append("%s interp/recompiler mismatches" % gr["mismatches"])
            ref = g["groups"].get(name) if g else None
            if ref and ref.get("crc_defined") != gr.get("crc_defined"):
                bad.append("defined %s, real CPU %s" % (gr.get("crc_defined"), ref.get("crc_defined")))
            note = ""
            if ref and ref.get("crc_raw") != gr.get("crc_raw"):
                note = "  (undefined flags differ from the real CPU)"
            if name in r["pass_diff"]:
                bad.append("passes disagree")
            if bad:
                ok = False
            w("  %-4s %-16s defined=%s raw=%s%s%s" % ("FAIL" if bad else "ok", name, gr.get("crc_defined"),
                                                       gr.get("crc_raw"), ("  " + "; ".join(bad)) if bad else "",
                                                       note))
        for name, why in r["skipped"].items():
            w("  skip %-16s %s" % (name, why))
        if r["version"] and not g:
            w("  (no real-CPU reference for %s v%s: compared only interpreter against recompiler)"
              % (fam.internal_name, r["version"]))
        w("")

    # The same CPU model must give the same answers on every board and at
    # every speed: the clock changes nothing the tests look at.
    for name in sorted({n for r in results for n in r["groups"]}):
        seen = {r["tag"]: r["groups"][name].get("crc_defined") for r in results if name in r["groups"]}
        if len(set(seen.values())) > 1:
            ok = False
            w("machines disagree on %s: %s" % (name, ", ".join("%s=%s" % kv for kv in seen.items())))
    w("RESULT %s" % ("PASS" if ok else "FAIL"))
    text = "\n".join(lines) + "\n"
    open(out, "w").write(text)
    return ok, text


# ---- commands ---------------------------------------------------------------

def image_info(path):
    h = hashlib.sha256(open(path, "rb").read()).hexdigest()[:12]
    src = path + ".source"
    origin = open(src).read().strip() if os.path.exists(src) else ""
    return "%s sha256:%s%s" % (os.path.relpath(path, HERE), h, ("  " + origin) if origin else "")


def cmd_sync(s):
    """The image as last committed where image_source lives: never a file
    build.py is halfway through writing."""
    src = expand(s.get("image_source", ""))
    repo = subprocess.run(["git", "-C", os.path.dirname(src), "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True).stdout.strip()
    os.makedirs(IMAGES, exist_ok=True)
    dst = os.path.join(IMAGES, "cputest.img")
    if repo:
        rel = os.path.relpath(src, repo)
        blob = subprocess.run(["git", "-C", repo, "show", "HEAD:" + rel], capture_output=True)
        if blob.returncode:
            raise SystemExit("%s is not committed in %s" % (rel, repo))
        open(dst + ".tmp", "wb").write(blob.stdout)
        os.replace(dst + ".tmp", dst)
        rev = subprocess.run(["git", "-C", repo, "log", "-1", "--format=%h %s"],
                             capture_output=True, text=True).stdout.strip()
        origin = "from %s at %s" % (src, rev)
    else:
        if not os.path.exists(src):
            raise SystemExit("image_source %s does not exist" % src)
        shutil.copy2(src, dst)
        origin = "from %s (not in git)" % src
    open(dst + ".source", "w").write(origin + "\n")
    print(image_info(dst))


def cmd_list(s, args):
    build = resolve_build(s, args.box)
    fams = tables.load_cpus(os.path.join(build["source"], "src"))
    machs = tables.load_machines(os.path.join(build["source"], "src"))
    wanted = [resolve_cpu(fams, args.cpu)] if args.cpu else None
    for t in templates():
        mach = machs.get(t["machine"])
        if not mach:
            print("%-14s %s: not in this build" % (t["slug"], t["machine"]))
            continue
        print("%-14s %s" % (t["slug"], mach.name))
        for fam in (wanted or fams.values()):
            ok = [c.name for c in fam.cpus if tables.is_eligible(fam, c, mach) and not c.out_of_spec]
            if ok:
                print("    %-14s %s" % (fam.internal_name, " ".join(ok)))
            elif wanted:
                print("    %-14s does not fit this board" % fam.internal_name)


def cmd_golden(s, args):
    s_build = resolve_build(s, args.box)
    fams = tables.load_cpus(os.path.join(s_build["source"], "src"))
    fam = resolve_cpu(fams, args.cpu)
    text = open(args.log, errors="replace").read()
    r = parse_log(text)
    if not r["version"] or not r["groups"]:
        raise SystemExit("%s: no CPUTEST header or no GROUP lines" % args.log)
    dst = golden_path(fam, r["version"])
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    # Header and one pass of GROUP lines is the whole reference.
    keep = [l for l in text.replace("\r", "").splitlines() if l.startswith(("CPUTEST ", "GROUP "))]
    seen, out = set(), []
    for l in keep:
        key = l.split()[1] if l.startswith("GROUP ") else "header"
        if key not in seen:
            seen.add(key)
            out.append(l)
    open(dst, "w").write("\n".join(out) + "\n")
    print("%s: %d groups, cpu %s" % (os.path.relpath(dst, HERE), len(r["groups"]), r["cpu"]))


def cmd_setup(s, args):
    """Boot one machine's template, image attached, for its BIOS setup, and
    take commands from CASE/ctl, one per line:

      key K ...     xdotool key names into the emulator window
      type TEXT     typed as it stands
      shot NAME     a screenshot, CASE/NAME.png
      save          the CMOS it has written, back into the template
      quit
    """
    build = resolve_build(s, args.box)
    if not build["fast_forward_option"]:
        raise SystemExit("%s cannot start a machine fast-forwarded" % build["label"])
    ts = templates([args.board])
    if len(ts) != 1:
        raise SystemExit("no single machine matches %r" % args.board)
    t = ts[0]
    image = expand(args.image) if args.image else os.path.join(IMAGES, "cputest.img")
    case = os.path.join(RESULTS, "setup-" + t["slug"].replace("/", "-"))
    cfg = prepare_case(s, build, image, t, case)
    ctl = os.path.join(case, "ctl")
    if os.path.exists(ctl):
        os.unlink(ctl)
    os.mkfifo(ctl)
    fd = os.open(ctl, os.O_RDONLY | os.O_NONBLOCK)
    box = launch.Box(case, os.path.join(case, "86Box.bin"))
    start = time.time()
    shown = 0
    try:
        box.start(cfg)
        say("setup %s: %s, display %s; commands to %s" % (t["slug"], build["label"], box.display, ctl))
        pending = b""
        while box.alive():
            box.pump(0.2)
            text = box.buf.decode("latin-1")
            if len(text) > shown:
                for line in text[shown:].splitlines():
                    if line.strip():
                        say("%6.1f COM1 %s" % (time.time() - start, line.strip()))
                shown = len(text)
            try:
                chunk = os.read(fd, 4096)
            except BlockingIOError:
                chunk = b""
            pending += chunk
            while b"\n" in pending:
                line, pending = pending.split(b"\n", 1)
                cmd, _, rest = line.decode().strip().partition(" ")
                if cmd == "key":
                    box.keys(*rest.split())
                elif cmd == "type":
                    subprocess.run(["xdotool", "type", "--delay", "80", rest], env=box.env, capture_output=True)
                elif cmd == "shot":
                    say("%6.1f shot %s" % (time.time() - start, box.shot(rest + ".png")))
                elif cmd == "save":
                    dst = os.path.join(t["dir"], "nvr")
                    saved = [f for f in os.listdir(os.path.join(case, "nvr")) if f.endswith(".nvr")]
                    for f in saved:
                        shutil.copy2(os.path.join(case, "nvr", f), dst)
                    say("%6.1f saved %s to %s" % (time.time() - start, " ".join(saved) or "nothing", dst))
                elif cmd == "quit":
                    return 0
                elif cmd:
                    say("unknown command %r" % cmd)
        say("emulator exited (%s)" % box.box.returncode)
    finally:
        box.stop()
        drop_copies(case)
        if os.path.exists(ctl):
            os.unlink(ctl)


def cmd_run(s, args):
    build = resolve_build(s, args.box)
    src = os.path.join(build["source"], "src")
    fams, machs = tables.load_cpus(src), tables.load_machines(src)
    fam = resolve_cpu(fams, args.cpu)
    image = expand(args.image) if args.image else os.path.join(IMAGES, "cputest.img")
    if not os.path.exists(image):
        raise SystemExit("%s missing: run cputest sync" % image)
    if not build["fast_forward_option"]:
        raise SystemExit("%s cannot start a machine fast-forwarded (no fast_forward option in its config.c)"
                         % build["label"])
    if args.interp and any("CPU_REQUIRES_DYNAREC" in c.flags for c in fam.cpus):
        raise SystemExit("%s needs the recompiler; --interp is not possible" % fam.name)

    jobs = []
    for t in templates(args.machine):
        mach = machs.get(t["machine"])
        if not mach:
            say("skip %-14s %s is not in %s" % (t["slug"], t["machine"], build["label"]))
            continue
        cpus = speeds_for(fam, mach, args.speed, args.all_speeds)
        if not cpus:
            say("skip %-14s does not take a %s%s" % (t["slug"], fam.name, (" " + args.speed) if args.speed else ""))
            continue
        if not [f for f in os.listdir(os.path.join(t["dir"], "nvr")) if f.endswith(".nvr")]:
            say("skip %-14s no saved CMOS: run cputest setup %s first" % (t["slug"], t["board"]))
            continue
        jobs += [(t, c) for c in cpus]
    if not jobs:
        raise SystemExit("no machine on file takes a %s" % fam.name)

    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    rundir = os.path.join(RESULTS, "%s-%s" % (stamp, fam.internal_name))
    os.makedirs(rundir)
    say("%s on %d machine(s), build %s, results in %s" % (fam.name, len(jobs), build["label"],
                                                         os.path.relpath(rundir)))
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, args.jobs)) as ex:
        futs = [ex.submit(run_one, s, build, image, fam, c, t, rundir, args) for t, c in jobs]
        results = [f.result() for f in futs]
    ok, text = report(fam, build, image_info(image), results, os.path.join(rundir, "summary.txt"))
    print()
    print(text, end="")
    return 0 if ok else 1


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("list", "sync", "golden", "setup"):
        cmd = argv.pop(0)
    else:
        cmd = "run"
    ap = argparse.ArgumentParser(prog="cputest " + (cmd if cmd != "run" else ""))
    ap.add_argument("--box", help="build name from local.toml, or a path to an 86Box binary")
    if cmd == "run":
        ap.add_argument("cpu")
        ap.add_argument("--machine", action="append", help="socket/board or board; repeatable")
        ap.add_argument("--speed", help="one speed, as 86Box names it (233, 400, ...)")
        ap.add_argument("--all-speeds", action="store_true", help="every in-spec speed the board takes")
        ap.add_argument("--image", help="another disk image instead of images/cputest.img")
        ap.add_argument("-j", "--jobs", type=int, default=2, help="machines at once (default 2)")
        ap.add_argument("--passes", type=int, default=1, help="passes to wait for (default 1)")
        ap.add_argument("--timeout", type=int, default=3600, help="seconds per machine (default 3600)")
        ap.add_argument("--interp", action="store_true", help="recompiler off, where the CPU allows it")
    elif cmd == "list":
        ap.add_argument("cpu", nargs="?")
    elif cmd == "setup":
        ap.add_argument("board")
        ap.add_argument("--image", help="another disk image instead of images/cputest.img")
    elif cmd == "golden":
        ap.add_argument("cpu")
        ap.add_argument("log", help="serial capture from the real machine")
    args = ap.parse_args(argv)
    s = settings()
    if cmd == "sync":
        return cmd_sync(s)
    if cmd == "list":
        return cmd_list(s, args)
    if cmd == "golden":
        return cmd_golden(s, args)
    if cmd == "setup":
        return cmd_setup(s, args)
    return cmd_run(s, args)


if __name__ == "__main__":
    sys.exit(main() or 0)
